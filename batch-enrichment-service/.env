# ------------------------------
# Supabase
# ------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-key

# ------------------------------
# Google Cloud / Vertex AI
# ------------------------------
GCP_PROJECT_ID=your-gcp-project-id

# ------------------------------
# Broadcast Job
# ------------------------------
SOURCE_ID=your_source_uuid_here
PROCESS_DATE=2025-12-24  # format: YYYY-MM-DD

# ------------------------------
# Heuristics (optional, defaults used if unset)
# ------------------------------
PAUSE_THRESHOLD=2.5          # seconds
JINGLE_THRESHOLD=8.0         # seconds
SONG_THRESHOLD=60.0          # seconds
AD_DURATIONS=15,30,45,60     # seconds
