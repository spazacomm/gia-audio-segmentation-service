# Required Configuration
SUPABASE_URL=https://nclmnuzdgmcuobduhteo.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Optional: Filter by specific source
SOURCE_ID=

# Processing Configuration
BATCH_SIZE=5
MAX_CONCURRENT=1

# Whisper Model Configuration
# Options: tiny, base, small, medium, large
# Recommended for CPU: tiny or base
WHISPER_MODEL=base

# Language Configuration
# Options: en, sw, fr, es, etc. or leave empty for auto-detect
WHISPER_LANGUAGE=en

# Device Configuration
WHISPER_DEVICE=cpu

# GCS Configuration
BUCKET_NAME=spaza-recordings

# Supported Labels (space-separated)
SUPPORTED_LABELS=female male