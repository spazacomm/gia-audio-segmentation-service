# Optimized environment configuration for 2 vCPU, 4GB RAM system
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

# Google Cloud Storage (optimized)
GCS_BUCKET=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Supabase (optimized)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# Audio Processing (optimized)
INA_SPEECH_SEGMENTER_MODEL=default

# Logging (reduced for performance)
LOG_LEVEL=WARNING

# Temporary file settings (optimized for low resources)
TEMP_DIR=/tmp/segmentation
MAX_TEMP_FILES=5
CLEANUP_ON_SHUTDOWN=true

# Resource limits for 2 vCPU, 4GB RAM
MAX_CONCURRENT_JOBS=1
MAX_MEMORY_MB=3072
AUDIO_CHUNK_SIZE_SECONDS=300
PROCESSING_TIMEOUT_SECONDS=1800

# Monitoring (optimized)
AUTO_CLEANUP_INTERVAL=300
DEBUG_CLEANUP=false