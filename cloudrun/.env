# Supabase Configuration
SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL" # e.g., https://abcde12345.supabase.co
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY" # This is a secret key, do not expose in public repos!

# Google Cloud Project ID (Optional, defaults to 'spaza-media-monitor' if not set)
GCP_PROJECT_ID="spaza-media-monitor"

# GCS Bucket (Optional, defaults to 'spaza-recordings' if not set)
GCS_RECORDINGS_BUCKET="spaza-recordings"
